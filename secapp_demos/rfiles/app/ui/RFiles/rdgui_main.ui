<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>RDGUIMain</class>
 <widget class="QMainWindow" name="RDGUIMain">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>550</width>
    <height>330</height>
   </rect>
  </property>
  
  <property name="minimumSize">
    <size>
      <width>550</width>
      <height>200</height>
    </size>
  </property>
  <property name="maximumSize">
    <size>
      <width>550</width>
      <height>100000</height>
    </size>
  </property>
  <!-- on Windows this also hides the maximize button -->
  <property name="windowFlags">
    <set>Qt::Window|Qt::MSWindowsFixedSizeDialogHint</set>
  </property>
  
  
  <property name="windowTitle">
   <string>GreenBox RFiles</string>
  </property>
  <property name="windowIcon">
   <iconset resource="rdgui.qrc">
    <normaloff>:/imgs/icon.png</normaloff>
    <normalon>:/imgs/icon.png</normalon>
   </iconset>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="verticalLayout_Main">
    <!-- Banner Header -->
    <item>
     <widget class="QLabel" name="headerLabel">
      <property name="pixmap">
       <pixmap resource="rdgui.qrc">:/imgs/banner.png</pixmap>
      </property>
      <property name="scaledContents">
       <bool>true</bool>
      </property>
      <property name="minimumHeight">
       <number>100</number>
      </property>
      <property name="maximumHeight">
       <number>120</number>
      </property>
      <property name="alignment">
       <set>Qt::AlignCenter</set>
      </property>
     </widget>
    </item>
    <!-- Connection Group -->
    <item>
     <widget class="QGroupBox" name="connectionGroup">
      <property name="title">
       <string>Connection</string>
      </property>
      <layout class="QVBoxLayout" name="verticalLayout_Group">
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_Host">
         <item>
          <widget class="QLabel" name="remoteHostLabel">
           <property name="text">
            <string>Remote Host:</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QComboBox" name="remoteHostComboBox">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
             <horstretch>0</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="editable">
            <bool>true</bool>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QLabel" name="instructionLabel">
         <property name="text">
          <string>Enter a name or an IP address. To specify a port number, append it after one colon (for example, mypc:5902).</string>
         </property>
         <property name="alignment">
          <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
    </item>
    <!-- Options Tabs -->
    <item>
     <widget class="QTabWidget" name="optionsTabWidget">
      <property name="visible">
       <bool>false</bool>
      </property>
      <property name="currentIndex">
       <number>0</number>
      </property>
      <!-- Experience Tab -->
      <widget class="QWidget" name="experienceTab">
       <attribute name="title">
        <string>Experience</string>
       </attribute>
       <layout class="QVBoxLayout" name="verticalLayout_Experience">
        <item>
         <widget class="QLabel" name="bandwidthLabel">
          <property name="text">
           <string>Optimize connection speed for:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QComboBox" name="bandwidthComboBox">
          <property name="toolTip">
           <string>Choose network speed to optimize performance</string>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="verticalSpacer_Experience">
          <property name="orientation">
           <enum>Qt::Orientation::Vertical</enum>
          </property>
          <property name="sizeType">
           <enum>QSizePolicy::Expanding</enum>
          </property>
         </spacer>
        </item>
       </layout>
      </widget>
      <!-- System Tab -->
      <widget class="QWidget" name="systemTab">
       <attribute name="title">
        <string>System</string>
       </attribute>
       <layout class="QVBoxLayout" name="verticalLayout_System">
        <item>
         <widget class="QGroupBox" name="historyGroup">
          <property name="title">
           <string>Connection History</string>
          </property>
          <layout class="QHBoxLayout">
           <item>
            <widget class="QPushButton" name="clearHistoryButton">
             <property name="text">
              <string>Clear History</string>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <spacer name="verticalSpacer_System">
          <property name="orientation">
           <enum>Qt::Orientation::Vertical</enum>
          </property>
          <property name="sizeType">
           <enum>QSizePolicy::Expanding</enum>
          </property>
         </spacer>
        </item>
       </layout>
      </widget>
     </widget>
    </item>
    <!-- Buttons -->
    <item>
     <layout class="QHBoxLayout" name="horizontalLayout_Buttons">
      <item>
       <widget class="QPushButton" name="optionsButton">
        <property name="text">
         <string>Show Options</string>
        </property>
       </widget>
      </item>
      <item>
       <spacer name="horizontalSpacer_Buttons">
        <property name="orientation">
         <enum>Qt::Orientation::Horizontal</enum>
        </property>
        <property name="sizeHint">
         <size>
          <width>40</width>
          <height>20</height>
         </size>
        </property>
       </spacer>
      </item>
      <item>
       <widget class="QPushButton" name="connectButton">
        <property name="enabled">
         <bool>false</bool>
        </property>
        <property name="text">
         <string>Connect</string>
        </property>
        <property name="default">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="helpButton">
        <property name="text">
         <string>Help</string>
        </property>
       </widget>
      </item>
     </layout>
    </item>
   </layout>
  </widget>
  <widget class="QMenuBar" name="menubar"/>
  <widget class="QStatusBar" name="statusbar"/>
 </widget>
 <resources>
  <include location="rdgui.qrc"/>
 </resources>
 <connections/>
</ui>
