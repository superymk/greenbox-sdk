mostlyclean-libtool:
	-rm -f *.lo

clean-libtool:
	-rm -rf .libs _libs
	-rm -rf src/.libs src/_libs
	-rm -rf src/cache/.libs src/cache/_libs
	-rm -rf src/cfg/.libs src/cfg/_libs
	-rm -rf src/openidc/.libs src/openidc/_libs
	-rm -rf src/server/.libs src/server/_libs

distclean-libtool:
	-rm -f libtool config.lt
install-liboauth2_apache_la_pkgconfigDATA: $(liboauth2_apache_la_pkgconfig_DATA)
	@$(NORMAL_INSTALL)
	@list='$(liboauth2_apache_la_pkgconfig_DATA)'; test -n "$(liboauth2_apache_la_pkgconfigdir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(liboauth2_apache_la_pkgconfigdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(liboauth2_apache_la_pkgconfigdir)" || exit 1; \
	fi; \
	for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  echo "$$d$$p"; \
	done | $(am__base_list) | \
	while read files; do \
	  echo " $(INSTALL_DATA) $$files '$(DESTDIR)$(liboauth2_apache_la_pkgconfigdir)'"; \
	  $(INSTALL_DATA) $$files "$(DESTDIR)$(liboauth2_apache_la_pkgconfigdir)" || exit $$?; \
	done

uninstall-liboauth2_apache_la_pkgconfigDATA:
	@$(NORMAL_UNINSTALL)
	@list='$(liboauth2_apache_la_pkgconfig_DATA)'; test -n "$(liboauth2_apache_la_pkgconfigdir)" || list=; \
	files=`for p in $$list; do echo $$p; done | sed -e 's|^.*/||'`; \
	dir='$(DESTDIR)$(liboauth2_apache_la_pkgconfigdir)'; $(am__uninstall_files_from_dir)
