	$(am__append_4) liboauth2_cache.la $(am__append_7) \
	$(am__append_10)
liboauth2_la_SOURCES = src/version.c src/mem.c src/log.c \
	src/util_int.h src/util.c src/cfg_int.h src/cfg/cfg.c \
	src/cfg/auth.c src/cfg/source.c src/cfg/cache_cfg.c \
	src/cfg/verify.c src/cfg/target.c src/cfg/proto_cfg.c \
	src/cfg/openidc_cfg.c src/cfg/session_cfg.c src/ipc.c \
	src/cache_int.h src/cache/shm.c src/cache/file.c \
	src/jose_int.h src/jose.c src/http.c src/proto.c \
	src/oauth2_int.h src/oauth2.c src/dpop.c src/session.c \
