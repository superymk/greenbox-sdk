@HAVE_CHECK_TRUE@	$(am__append_16) $(am__append_19)
@HAVE_CHECK_TRUE@check_liboauth2_CFLAGS = @OPENSSL_CFLAGS@ \
@HAVE_CHECK_TRUE@	@CURL_CFLAGS@ @CJOSE_CFLAGS@ @PCRE2_CFLAGS@ \
@HAVE_CHECK_TRUE@	@JQ_CFLAGS@ @CHECK_CFLAGS@ $(am__append_17) \
@HAVE_CHECK_TRUE@	$(am__append_20)
@HAVE_CHECK_TRUE@check_liboauth2_LDADD = liboauth2.la $(am__append_18) \
@HAVE_CHECK_TRUE@	$(am__append_21) @OPENSSL_LIBS@ @CURL_LIBS@ \
@HAVE_CHECK_TRUE@	@CJOSE_LIBS@ @PCRE2_LIBS@ @CHECK_LIBS@ \
@HAVE_CHECK_TRUE@	$(am__empty)
@HAVE_CHECK_TRUE@check_liboauth2_SOURCES = test/check_liboauth2.h \
@HAVE_CHECK_TRUE@	test/check_liboauth2.c test/check_version.c \
@HAVE_CHECK_TRUE@	test/check_mem.c test/check_log.c \
@HAVE_CHECK_TRUE@	test/check_cfg.c test/check_util.c \
@HAVE_CHECK_TRUE@	test/check_ipc.c test/check_cache.c \
@HAVE_CHECK_TRUE@	test/check_jose.c test/check_http.c \
@HAVE_CHECK_TRUE@	test/check_proto.c test/check_oauth2.c \
@HAVE_CHECK_TRUE@	test/check_openidc.c test/server_stubs.c \
@HAVE_CHECK_TRUE@	test/provider.json test/client.json \
@HAVE_CHECK_TRUE@	$(am__append_22) $(am__append_23) \
@HAVE_CHECK_TRUE@	$(am__append_24)
TAG = liboauth2/test
all: all-am

.SUFFIXES:
