	$(liboauth2_cache_la_SOURCES) $(liboauth2_memcache_la_SOURCES) \
	$(liboauth2_nginx_la_SOURCES) $(liboauth2_redis_la_SOURCES) \
	$(check_liboauth2_SOURCES)
DIST_SOURCES = $(am__liboauth2_la_SOURCES_DIST) \
	$(am__liboauth2_apache_la_SOURCES_DIST) \
