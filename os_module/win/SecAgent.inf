;
; SecAgent.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=System ; TODO: specify appropriate Class
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider=%ManufacturerName%
CatalogFile=SecAgent.cat
DriverVer= ; TODO: set DriverVer in stampinf property pages
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12
SecAgent_Device_CoInstaller_CopyFiles = 11

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
SecAgent.sys  = 1,,
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll=1 ; make sure the number matches with SourceDisksNames

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$

[Standard.NT$ARCH$]
%SecAgent.DeviceDesc%=SecAgent_Device, Root\SecAgent ; TODO: edit hw-id

[SecAgent_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
SecAgent.sys

;-------------- Service installation
[SecAgent_Device.NT.Services]
AddService = SecAgent,%SPSVCINST_ASSOCSERVICE%, SecAgent_Service_Inst

; -------------- SecAgent driver install sections
[SecAgent_Service_Inst]
DisplayName    = %SecAgent.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\SecAgent.sys

;
;--- SecAgent_Device Coinstaller installation ------
;

[SecAgent_Device.NT.CoInstallers]
AddReg=SecAgent_Device_CoInstaller_AddReg
CopyFiles=SecAgent_Device_CoInstaller_CopyFiles

[SecAgent_Device_CoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000, "WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll,WdfCoInstaller"

[SecAgent_Device_CoInstaller_CopyFiles]
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll

[SecAgent_Device.NT.Wdf]
KmdfService =  SecAgent, SecAgent_wdfsect
[SecAgent_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
ManufacturerName="<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "SecAgent Installation Disk"
SecAgent.DeviceDesc = "SecAgent Device"
SecAgent.SVCDESC = "SecAgent Service"
